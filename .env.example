# Database
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"

# Neon Authentication
NEON_AUTH_BASE_URL="https://your-project.neonauth.neon.tech/neondb/auth"
NEXT_PUBLIC_NEON_AUTH_BASE_URL="https://your-project.neonauth.neon.tech/neondb/auth"
NEON_AUTH_COOKIE_SECRET="your-32-char-random-secret-minimum"

# UploadThing (Optional - for file uploads)
UPLOADTHING_TOKEN="your-uploadthing-token"
UPLOADTHING_APP_ID="your-uploadthing-app-id"

# Upstash Redis (Optional - for rate limiting)
UPSTASH_REDIS_REST_URL="https://xxxx.upstash.io"
UPSTASH_REDIS_REST_TOKEN="xxxx"
