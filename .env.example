# ==============================================================================
# DATABASE CONFIGURATION
# ==============================================================================
# PostgreSQL database connection strings for Neon
# DATABASE_URL: Main connection string with connection pooling
# DIRECT_URL: Direct connection string for migrations and admin operations
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"

# ==============================================================================
# CLERK AUTHENTICATION CONFIGURATION
# ==============================================================================
# Get these keys from your Clerk Dashboard: https://dashboard.clerk.com
# 
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY: Public key for client-side Clerk SDK
# - Safe to expose in browser
# - Used for Clerk initialization on the client
# - Format: pk_test_xxxxx or pk_live_xxxxx
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_xxxxx"

# CLERK_SECRET_KEY: Secret key for server-side Clerk operations
# - NEVER commit this to version control
# - Used for server-side authentication and API calls
# - Format: sk_test_xxxxx or sk_live_xxxxx
CLERK_SECRET_KEY="sk_test_xxxxx"

# NEXT_PUBLIC_CLERK_SIGN_IN_URL: URL where users are redirected for sign-in
# - Must match your sign-in page route
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"

# NEXT_PUBLIC_CLERK_SIGN_UP_URL: URL where users are redirected for sign-up
# - Must match your sign-up page route
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"

# CLERK_WEBHOOK_SECRET: Secret for verifying Clerk webhooks
# - NEVER commit this to version control
# - Get this from Clerk Dashboard after creating a webhook
# - Used to verify webhook signatures for security
# - See docs/CLERK_WEBHOOK_SETUP.md for setup instructions
# - Format: whsec_xxxxx
CLERK_WEBHOOK_SECRET="whsec_xxxxx"

# ==============================================================================
# FILE UPLOAD CONFIGURATION (UploadThing)
# ==============================================================================
# Required for file upload functionality (covers, PDFs, etc.)
# Get these from: https://uploadthing.com/dashboard
UPLOADTHING_TOKEN="your-uploadthing-token"
UPLOADTHING_APP_ID="your-uploadthing-app-id"

# ==============================================================================
# RATE LIMITING CONFIGURATION (Upstash Redis)
# ==============================================================================
# Required for download rate limiting and other rate-limited operations
# Get these from: https://upstash.com/
UPSTASH_REDIS_REST_URL="https://xxxx.upstash.io"
UPSTASH_REDIS_REST_TOKEN="xxxx"

# ==============================================================================
# SECURITY NOTES
# ==============================================================================
# - Never commit .env files to version control
# - Use different keys for development and production
# - Rotate secrets periodically
# - Monitor webhook delivery logs for suspicious activity
# - Keep webhook secrets secure and update them if compromised
