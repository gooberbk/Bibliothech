generator client {
  provider = "prisma-client-js"
  previewFeatures = ["schemaEngineDriverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  USER
  ADMIN
}

model User {
  id            String    @id @default(cuid())
  clerkId       String?   @unique
  neonId        String?   @unique
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  role          Role      @default(USER)
  bio           String?   @db.Text
  socialLinks   String?   @db.Text // JSON string for social links
  academicInfo  String?   @db.Text // JSON string for academic info
  profileVisible Boolean  @default(true)
  activityVisible Boolean @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lastSyncAt    DateTime?

  favorites  Favorite[]
  downloads  Download[]
  activities UserActivity[]
  badges     UserBadge[]
}

model Category {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  resources Resource[]
}

model Resource {
  id          String   @id @default(cuid())
  title       String
  author      String
  description String?  @db.Text
  category    String
  categoryId  String?
  type        String
  pageCount   Int
  fileSizeMb  Float
  fileUrl     String
  fileKey     String
  coverUrl    String
  coverKey    String

  downloadCount Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  favoritedBy  Favorite[]
  downloadedBy Download[]
  categoryRelation Category? @relation(fields: [categoryId], references: [id])

  @@index([category])
  @@index([type])
  @@index([categoryId])
}

model Favorite {
  id         String   @id @default(cuid())
  userId     String
  resourceId String
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  resource Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@unique([userId, resourceId])
  @@index([userId])
}

model Download {
  id         String   @id @default(cuid())
  userId     String?
  resourceId String
  createdAt  DateTime @default(now())

  user     User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  resource Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@index([resourceId])
}

model UserActivity {
  id          String   @id @default(cuid())
  userId      String
  action      String   // "download", "favorite", "profile_view", "login", etc.
  entityId    String?  // Optional ID of related entity (resource, etc.)
  entityType  String?  // Optional type of entity ("resource", "user", etc.)
  metadata    String?  @db.Text // JSON string for additional data
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

model Badge {
  id             String   @id @default(cuid())
  name           String   @unique
  description    String
  icon           String   // Emoji or icon name
  requirementType String  // "downloads", "favorites", "logins", "views"
  requirementValue Int    // Number required to earn badge
  createdAt      DateTime @default(now())

  userBadges UserBadge[]
}

model UserBadge {
  id        String   @id @default(cuid())
  userId    String
  badgeId   String
  earnedAt  DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge Badge @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
  @@index([userId])
  @@index([badgeId])
}
